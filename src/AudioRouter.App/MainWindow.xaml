<Window x:Class="AudioRouter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AudioRouter.App"
        Title="Audio Router" Width="1080" Height="840" MinWidth="940" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="#0C131B" FontFamily="Segoe UI Variable, Segoe UI"
        Foreground="#EAF1F8" Loaded="Window_Loaded" Closing="Window_Closing"
        IsVisibleChanged="Window_VisibilityChanged" StateChanged="Window_StateChanged">
  <Window.Resources><local:ApplicationIconConverter x:Key="AppIcon"/></Window.Resources>
  <Grid Margin="30,24,30,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="*"/>
      <RowDefinition Height="16"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="48" Height="48" CornerRadius="13" Background="#54E1BD" Margin="0,0,14,0" VerticalAlignment="Center">
          <Path Data="M 10,24 L 15,24 15,16 19,16 19,32 23,32 23,10 27,10 27,37 31,37 31,20 35,20 35,24 39,24"
                Stroke="#10251E" StrokeThickness="2.5" StrokeLineJoin="Round" Stretch="Uniform" Margin="10"/>
        </Border>
        <StackPanel><TextBlock Text="Audio Router" FontSize="27" FontWeight="SemiBold"/>
          <TextBlock Text="Share an app’s audio alongside your voice." Foreground="{StaticResource MutedText}" FontSize="13" Margin="0,3,0,0"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <CheckBox x:Name="LiveMetersCheck" Content="Live meters" Checked="LiveMeters_Changed" Unchecked="LiveMeters_Changed"
                  VerticalAlignment="Center" Margin="0,0,18,0" FontSize="12" ToolTip="Show live level bars and dB. Off saves meter calculations and UI updates."/>
        <Border x:Name="StateBadge" Background="#1D2A35" CornerRadius="12" Height="36" Padding="12,0" Margin="0,0,14,0" VerticalAlignment="Center">
          <TextBlock x:Name="StateLabel" Text="STOPPED" FontSize="11" FontWeight="SemiBold" Foreground="#A8B7C6" VerticalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0"/>
        </Border>
        <Button x:Name="SetupGuideButton" Content="Setup guide" Click="Setup_Click" Height="36" Padding="14,0" VerticalAlignment="Center" AutomationProperties.Name="Open setup guide"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.04*"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel><TextBlock Text="01   CHOOSE AN APPLICATION" Style="{StaticResource SectionLabel}"/>
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" HorizontalAlignment="Right" Click="Refresh_Click" Padding="8,3" FontSize="11" Margin="0,-6,0,6"/></DockPanel>
          <TextBlock Grid.Row="1" Text="What would you like to share?" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <Grid Grid.Row="2" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" Padding="10,8"
                     ToolTip="Search running applications" AutomationProperties.Name="Search applications"/>
            <TextBlock Text="Search applications…" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" IsHitTestVisible="False">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style></TextBlock.Style>
            </TextBlock>
          </Grid>
          <Grid Grid.Row="3">
            <ListBox x:Name="SourceList" Background="#0F1821" BorderBrush="#293847" BorderThickness="1" Padding="5"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Source_SelectionChanged"
                     AutomationProperties.Name="Application to share">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="9,9"/>
                <Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate>
                <Grid ToolTip="{Binding ExecutablePath}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Image Width="24" Height="24" Source="{Binding ExecutablePath, Converter={StaticResource AppIcon}}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                  <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyListLabel" Text="No matching applications.&#x0a;Open an app, then refresh." TextAlignment="Center"
                       VerticalAlignment="Center" Foreground="{StaticResource MutedText}" IsHitTestVisible="False" Visibility="Collapsed"/>
          </Grid>
          <TextBlock Grid.Row="4" x:Name="ApplicationCount" Text="Finding running applications…" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,8,0,16"/>
          <Grid Grid.Row="5"><TextBlock Text="Music sent to others" FontSize="13"/>
            <TextBlock x:Name="MusicGainLabel" Text="25%" HorizontalAlignment="Right" Foreground="#54E1BD"/>
          </Grid>
          <StackPanel Grid.Row="6">
            <Slider x:Name="MusicSlider" Minimum="0" Maximum="200" Value="25" ValueChanged="Gain_Changed" Margin="0,10,0,5" AutomationProperties.Name="Music level sent to others"
                    ToolTip="100% is the captured level. 200% doubles the outgoing signal (+6 dB). Your listening volume stays separate."/>
            <ProgressBar x:Name="MusicMeter" Maximum="100" Height="4" Foreground="#54E1BD" Background="#293847" BorderThickness="0"/>
            <TextBlock Text="Whole app, including all browser tabs." FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,10,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="02   ADD YOUR MICROPHONE" Style="{StaticResource SectionLabel}"/>
            <ComboBox x:Name="MicrophoneBox" DisplayMemberPath="DisplayName" SelectionChanged="Device_SelectionChanged" Padding="8,7" AutomationProperties.Name="Your microphone"/>
            <Grid Margin="0,18,0,0"><TextBlock Text="Your voice" FontSize="13"/>
              <TextBlock x:Name="MicGainLabel" Text="100%" HorizontalAlignment="Right" Foreground="#54E1BD"/>
            </Grid>
            <Slider x:Name="MicrophoneSlider" Minimum="0" Maximum="200" Value="100" ValueChanged="Gain_Changed" Margin="0,10,0,5" AutomationProperties.Name="Microphone level"/>
            <ProgressBar x:Name="MicMeter" Maximum="100" Height="4" Foreground="#54E1BD" Background="#293847" BorderThickness="0"/>
            <CheckBox x:Name="MuteMicCheck" Content="Mute microphone" Checked="Mute_Changed" Unchecked="Mute_Changed" Margin="0,15,0,0" FontSize="12"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="03   USE IN ANY GAME OR APP" Style="{StaticResource SectionLabel}"/>
            <ComboBox Grid.Row="1" x:Name="CableBox" DisplayMemberPath="Name" SelectionChanged="Device_SelectionChanged" Padding="8,7" AutomationProperties.Name="Virtual cable output"/>
            <Border Grid.Row="2" x:Name="CableMissingPanel" Background="#332A18" BorderBrush="#66502A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="One-time setup: install VB-CABLE" Foreground="#FFDC99" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Text="It adds a microphone other apps can use. Your normal speakers stay in place." Foreground="#D6C7A9" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,10"/>
                <Button Content="Get VB-CABLE ↗" HorizontalAlignment="Left" Click="DownloadCable_Click" Padding="12,5"/>
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="3" x:Name="TargetInstructions" Margin="0,14,0,12">
              <TextBlock Text="Microphone for your destination app" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock x:Name="TargetMicrophoneHint" Text="Set that app’s input to CABLE Output." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,5,0,0"/>
              <TextBlock Text="Keep your usual speaker output selected." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,9,0,0"/>
              <Button x:Name="TargetGuideButton" Content="How to set up any app" Click="Setup_Click" HorizontalAlignment="Left" Padding="10,5" Margin="0,12,0,0" FontSize="12"/>
            </StackPanel>
            <StackPanel Grid.Row="4" x:Name="OutputMetersPanel"><Grid><TextBlock Text="Combined output" FontSize="11" Foreground="{StaticResource MutedText}"/>
              <TextBlock x:Name="OutputLevelLabel" Text="Silent" FontSize="11" HorizontalAlignment="Right" Foreground="{StaticResource MutedText}"/></Grid>
              <ProgressBar x:Name="OutputMeter" Height="5" Maximum="100" Foreground="#54E1BD" Background="#293847" BorderThickness="0" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="4" Background="#141E29" CornerRadius="12" BorderBrush="#293847" BorderThickness="1" Padding="18,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,20,0">
          <CheckBox x:Name="ShareCheck" Content="Share application audio" IsChecked="True" Checked="Share_Changed" Unchecked="Share_Changed" FontWeight="SemiBold"/>
          <TextBlock x:Name="StatusText" Text="Select an application and microphone to get started." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,8,0,0"/>
          <TextBlock Text="Closing this window keeps routing in the tray. Use the tray menu to open or exit Audio Router." TextWrapping="Wrap" FontSize="11" Foreground="#8194A6" Margin="0,7,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" x:Name="StartButton" Content="Start routing" Width="154" Height="44" FontWeight="SemiBold"
                Background="#54E1BD" Foreground="#0A241C" VerticalAlignment="Center" Click="Start_Click" IsEnabled="False"/>
      </Grid>
    </Border>
  </Grid>
</Window>
